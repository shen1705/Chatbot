# ==============================================================================
# Chatbot RAG Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. LlamaParse API Key (Get from: https://cloud.llamaindex.ai/)
# Required if you want to parse complex tables / PDF structure via LlamaParse
LLAMAPARSE_API_KEY=your_llamaparse_api_key_here

# 3. Model Configuration (Optional - Defaults are provided in code)
# LLM Models:
#   - models/gemini-2.0-flash (Recommended: ultra-fast, 1M context, high accuracy)
#   - models/gemini-1.5-flash (Stable, fast, economical)
#   - models/gemini-1.5-pro   (Best deep reasoning and multi-hop synthesis)
LLM_MODEL=models/gemini-2.0-flash

# Embedding Models:
#   - BAAI/bge-m3 (Recommended SOTA: 8192 context length, 1024 dims, top Vietnamese retrieval)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (Lightweight, 128 context)
#   - bkai-foundation-models/vietnamese-bi-encoder (Fine-tuned for Vietnamese documents)
#   - models/text-embedding-004 (Google Cloud Embedding via Gemini API)
EMBEDDING_MODEL=BAAI/bge-m3
